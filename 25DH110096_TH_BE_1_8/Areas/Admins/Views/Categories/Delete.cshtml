@model _25DH110096_TH_BE_1_8.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admins/Views/Shared/_AdminsLayout.cshtml";

}

<h2 class="bg-success">XÓA DANH MỤC</h2>

<h4 class="alert-danger">Bạn có chắc muốn xóa danh mục nay ?</h4>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        <div class="form-group row mb-3">
            <div class="col-md-2 text-md-end"><label class="col-form-label">Tên Danh Mục : </label></div>
            <div class="col-md-10 ">
                @* hiển thị giá trị Category *@
                @Html.DisplayFor(model => model.CategoryName)
            </div>


            <div class="row mb-3">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Xóa" class="btn btn-danger" />
                    @Html.ActionLink("Quay lại trang", "Index", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </div>
}
