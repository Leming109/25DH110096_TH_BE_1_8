@model _25DH110096_TH_BE_1_8.Models.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admins/Views/Shared/_AdminsLayout.cshtml";

}

<h2 class="bg-success">CẬP NHẬT SẢN PHẨM</h2>

@using (Html.BeginForm("Edit", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ProductID)

        @Html.Partial("PartialView_Products", Model)

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Thêm Mới" class="btn btn-default" />
                @Html.ActionLink("Quay lại trang", "Index", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
}


