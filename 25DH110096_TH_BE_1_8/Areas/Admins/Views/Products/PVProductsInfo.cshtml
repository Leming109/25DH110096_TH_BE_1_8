@model _25DH110096_TH_BE_1_8.Models.Product

<head>
    <style>
        img {
            height: 250px;
            max-width: 250px;
        }
    </style>
</head>

<div class="container-fluid">
    <div class="div-horizontal bg-info">
        <div class="col-md-3">
            <img src="@Html.DisplayFor(model => model.ProductImage)" />
        </div>
        <div class="col-md-9 bg-info">
            <dl class="dl-horizontal">
                <dt>Tên Sản Phẩm</dt>
                <dd>@Html.DisplayFor(model => model.ProductName)</dd>

                <dt>Mô Tả</dt>
                <dd>@Html.DisplayFor(model => model.ProductDecription)</dd>

                <dt>Đơn Giá</dt>
                <dd>@Html.DisplayFor(model => model.ProductPrice)</dd>

                <dt>Danh Mục</dt>
                <dd>@Html.DisplayFor(model => model.Category.CategoryName)</dd>
            </dl>
        </div>
    </div>
</div>

